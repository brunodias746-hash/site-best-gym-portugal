{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.dc.html" },
    { "source": "/unidades", "destination": "/unidades.dc.html" },
    { "source": "/unidade-valongo", "destination": "/unidade-valongo.dc.html" },
    { "source": "/unidade-famalicao", "destination": "/unidade-famalicao.dc.html" },
    { "source": "/built-by-best", "destination": "/built-by-best.dc.html" },
    { "source": "/produtos", "destination": "/produtos.dc.html" },
    { "source": "/conteudos", "destination": "/conteudos.dc.html" },
    { "source": "/sobre", "destination": "/sobre.dc.html" },
    { "source": "/contactos", "destination": "/contactos.dc.html" },
    { "source": "/inscricao", "destination": "/inscricao.dc.html" },
    { "source": "/campanha", "destination": "/campanha.dc.html" },
    { "source": "/faq", "destination": "/faq.dc.html" },
    { "source": "/em-breve", "destination": "/em-breve.dc.html" },
    { "source": "/privacidade", "destination": "/privacidade.dc.html" },
    { "source": "/termos", "destination": "/termos.dc.html" },
    { "source": "/cookies", "destination": "/cookies.dc.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_ds/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
